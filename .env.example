PYDANTIC_V2=1
LOG_LEVEL=DEBUG

# --- bedrock: AWS credentials ---
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=<aws-profile-with-bedrock-access>
AWS_CLAUDE_DEFAULT_CLIENT=legacy  # legacy | mantle | converse

# --- vertexai: GCP credentials ---
# Omit GOOGLE_APPLICATION_CREDENTIALS to use application-default credentials.
GCP_PROJECT_ID=<gcp-project-id>
GCP_DEFAULT_REGION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account.json

# --- openai: which deployments its integration suite exercises ---
# The deployment table is credential-bearing, so it is not in this repo. Point
# this at a copy of it -- an absolute path, since pytest runs from the repo
# root. Without it the suite loads a noop config and silently tests nothing.
INTEGRATION_TEST_DEPLOYMENTS_CONFIG_PATH=/abs/path/to/integration_test_config.json
AZURE_API_VERSION=2023-12-01-preview
TIKTOKEN_MODEL_MAPPING={}
ELIMINATE_EMPTY_CHOICES=false
GPT4O_DEPLOYMENTS=<comma-separated deployment ids>
GPT4O_MINI_DEPLOYMENTS=
GPT_IMAGE_1_DEPLOYMENTS=
DALLE3_DEPLOYMENTS=
DATABRICKS_DEPLOYMENTS=
MISTRAL_DEPLOYMENTS=
NON_STREAMING_DEPLOYMENTS=
AZURE_AI_VISION_DEPLOYMENTS=
INTEGRATION_TEST_AZURE_FOUNDRY_SERVICE_NAME=<azure-foundry-service-name>

# --- test and server knobs ---
INTEGRATION_TEST_CLEANUP_MOCK_STORAGE=false
WEB_CONCURRENCY=1  # uvicorn workers, `make serve` only

# PYTEST_XDIST_AUTO_NUM_WORKERS is deliberately NOT set here. It would raise
# `-n=auto` above the core count for every run, including the unit suites, where
# oversubscription makes the openai SSE-heartbeat test (a 1s wall-clock
# assertion) flaky. The integration suites are network-bound and do benefit from
# it, so pass it per run instead:
#
#   make integration_tests_smoke ARGS='-n 16'

# --- verbose client logs, off by default ---
# OPENAI_LOG=debug
# ANTHROPIC_LOG=debug
# DIAL_SDK_LOG=DEBUG

# --- telemetry, off by default ---
# OTEL_TRACES_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_RESOURCE_ATTRIBUTES=service.name=ai-dial-model-provider
# OTEL_PYTHON_LOG_CORRELATION=true
# OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=/health
